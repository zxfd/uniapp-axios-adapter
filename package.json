{
  "name": "uniapp-axios-adapter",
  "version": "0.3.5",
  "packageManager": "pnpm@10.15.0",
  "description": "axios adapter for uni.request",
  "main": "lib/index.esm.js",
  "scripts": {
    "test": "node --experimental-default-type=module --test test/*.test.js",
    "test:types": "tsc --noEmit --strict --skipLibCheck --module Node16 --moduleResolution Node16 test/types.ts",
    "release": "release-it",
    "prebuild": "yarn release",
    "build": "rollup -c && yarn zip",
    "zip": "zip -r uniapp-axios-adapter.zip lib index.d.ts README.md CHANGELOG.md package.json"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./lib/index.cjs.js",
      "import": "./lib/index.esm.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "lib",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "index.d.ts"
  ],
  "keywords": [
    "axios",
    "uni-app",
    "adapter",
    "小程序",
    "微信小程序",
    "请求"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zxfd/uniapp-axios-adapter"
  },
  "author": "zxiaofoo@qq.com",
  "license": "MIT",
  "devDependencies": {
    "@release-it/conventional-changelog": "^5.1.1",
    "release-it": "^15.5.0",
    "rollup": "^3.2.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "axios": "*"
  }
}
